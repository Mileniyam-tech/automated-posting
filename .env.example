# ==============================================================================
# Automated Multi-Platform Posting System - Environment Variables Configuration
# ==============================================================================

# Application Settings
APP_NAME="Automated Multi-Platform Posting System"
APP_HOST="0.0.0.0"
APP_PORT=4000
HTTP_TIMEOUT_SECONDS=10.0

# When set to True, platforms without valid credentials will safely simulate
# successful publication so you can evaluate the full system without live API keys.
# Set to False to enforce strict live-only API calling (unconfigured will return Failed).
ALLOW_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# 1. Telegram Bot API Integration
# Docs: https://core.telegram.org/bots/api#sendmessage
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# ------------------------------------------------------------------------------
# 2. Discord Webhook Integration
# Docs: https://discord.com/developers/docs/resources/webhook#execute-webhook
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL="your_discord_webhook_url"

# ------------------------------------------------------------------------------
# 3. Slack Incoming Webhook Integration
# Docs: https://api.slack.com/messaging/webhooks
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL="your_slack_webhook_url"

# ------------------------------------------------------------------------------
# 4. Mastodon REST API Integration (Decentralized Social Network)
# Docs: https://docs.joinmastodon.org/methods/statuses/#create
# ------------------------------------------------------------------------------
MASTODON_INSTANCE_URL="https://mastodon.social"
MASTODON_ACCESS_TOKEN="your_mastodon_access_token"

# ------------------------------------------------------------------------------
# 5. Bluesky / AT Protocol Integration
# Docs: https://docs.bsky.app/docs/api/com/atproto/repo/create-record
# ------------------------------------------------------------------------------
BLUESKY_HANDLE="your_handle.bsky.social"
BLUESKY_APP_PASSWORD="your_bluesky_app_password"
BLUESKY_PDS_URL="https://bsky.social"

# ------------------------------------------------------------------------------
# 6. Hugging Face LLM & AI Platform Discussions Integration
# Docs: https://huggingface.co/docs/hub/api
# ------------------------------------------------------------------------------
HUGGINGFACE_API_TOKEN="your_huggingface_token"
HUGGINGFACE_REPO_ID="your_username/your_repo"
